  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6c6f85", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#40a02b" }
    },
    {
      "name": "String escapes and entities",
      "scope": ["constant.character.escape", "constant.character.entity"],
      "settings": { "foreground": "#ea76cb" }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp"
      ],
      "settings": { "foreground": "#04a5e5" }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "keyword.other.unit",
        "punctuation.definition.constant"
      ],
      "settings": { "foreground": "#8839ef" }
    },
    {
      "name": "Keywords and main syntax",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "keyword.operator.word",
        "keyword.operator.wordlike",
        "keyword.operator.logical.python",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "punctuation.definition.keyword",
        "punctuation.section.embedded",
        "punctuation.definition.template-expression"
      ],
      "settings": { "foreground": "#FF00BB" }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": { "foreground": "#5c5f77" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "support.function",
        "variable.function",
        "entity.name.command", 
        "meta.use.rust"
      ],
      "settings": { "foreground": "#FE640B" }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.numeric",
        "storage.type.string.go",
        "storage.type.boolean",
        "storage.type.core",
        "keyword.type"
      ],
      "settings": { "foreground": "#1e66f5" }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.module",
        "entity.name.type.namespace",
        "support.module",
        "entity.name.scope-resolution"
      ],
      "settings": { "foreground": "#7287fd" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#4c4f69" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#e64553" }
    },
    {
      "name": "this / self",
      "scope": ["variable.language"],
      "settings": { "foreground": "#d20f39", "fontStyle": "italic" }
    },
    {
      "name": "Properties, keys, attributes",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "punctuation.support.type.property-name",
        "entity.name.tag.yaml",
        "entity.other.attribute-name",
        "keyword.other.definition.ini"
      ],
      "settings": { "foreground": "#179299" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#FF00BB" }
    },
    {
      "name": "CSS classes and ids",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": { "foreground": "#1e66f5" }
    },
    {
      "name": "CSS pseudo selectors",
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": { "foreground": "#209fb5" }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation",
        "meta.annotation",
        "punctuation.definition.annotation",
        "meta.attribute.rust",
        "punctuation.definition.attribute.rust",
        "meta.decorator entity.name.function"
      ],
      "settings": { "foreground": "#df8e1d" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading"
      ],
      "settings": { "foreground": "#FF00BB", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": { "foreground": "#e64553", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": { "foreground": "#e64553", "fontStyle": "italic" }
    },
    {
      "name": "Markdown strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "foreground": "#7c7f93", "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.raw.inline"],
      "settings": { "foreground": "#40a02b" }
    },
    {
      "name": "Markdown fence language",
      "scope": ["fenced_code.block.language"],
      "settings": { "foreground": "#6c6f85" }
    },
    {
      "name": "Markdown link text",
      "scope": ["string.other.link"],
      "settings": { "foreground": "#1e66f5" }
    },
    {
      "name": "Markdown link brackets",
      "scope": [
        "punctuation.definition.string.begin.markdown",
        "punctuation.definition.string.end.markdown"
      ],
      "settings": { "foreground": "#5c5f77" }
    },
    {
      "name": "Markdown link url",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#209fb5", "fontStyle": "underline" }
    },
    {
      "name": "Markdown quotes",
      "scope": ["markup.quote", "punctuation.definition.quote"],
      "settings": { "foreground": "#6c6f85", "fontStyle": "italic" }
    },
    {
      "name": "Markdown list markers",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": { "foreground": "#df8e1d" }
    },
    {
      "name": "Markdown separators",
      "scope": ["meta.separator"],
      "settings": { "foreground": "#7c7f93" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": { "foreground": "#40a02b" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "punctuation.definition.deleted"],
      "settings": { "foreground": "#d20f39" }
    },
    {
      "name": "Diff changed and headers",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed",
        "meta.diff.header"
      ],
      "settings": { "foreground": "#1e66f5" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": { "foreground": "#d20f39" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#e64553", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#7287fd",
    "class": "#1e66f5",
    "interface": "#1e66f5",
    "enum": "#1e66f5",
    "struct": "#1e66f5",
    "type": "#1e66f5",
    "typeParameter": "#7287fd",
    "function": "#FE640B",
    "method": "#FE640B",
    "macro": "#FE640B",
    "decorator": "#df8e1d",
    "parameter": "#e64553",
    "property": "#179299",
    "enumMember": "#8839ef",
    "variable.readonly": "#8839ef",
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
