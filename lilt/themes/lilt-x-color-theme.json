        "string.regexp constant.character.set",
        "string.regexp constant.other.set",
        "string.regexp constant.character.numeric",
        "string.regexp constant.character.unicode",
        "string.regexp constant.character.control"
      ],
      "settings": {
        "foreground": "#91DDFF"
      }
    },
    {
      "name": "Regex quantifiers, anchors & alternation",
      "scope": [
        "string.regexp keyword.operator.quantifier",
        "string.regexp keyword.control.anchor",
        "string.regexp keyword.operator.or",
        "string.regexp keyword.operator.disjunction",
        "string.regexp keyword.operator.negation",
        "string.regexp keyword.operator.lookahead",
        "string.regexp keyword.operator.lookbehind"
      ],
      "settings": {
        "foreground": "#FF75C3"
      }
    },
    {
      "name": "Regex groups",
      "scope": [
        "string.regexp punctuation.definition.group",
        "string.regexp punctuation.definition.character-class",
        "string.regexp support.other.parenthesis"
      ],
      "settings": {
        "foreground": "#F9E2AF"
      }
    },
    {
      "name": "JSON key quotes",
      "scope": [
        "punctuation.support.type.property-name.begin.json",
        "punctuation.support.type.property-name.end.json"
      ],
      "settings": {
        "foreground": "#63F2F1"
      }
    },
    {
      "name": "JSON value quotes",
      "scope": [
        "punctuation.definition.string.begin.json",
        "punctuation.definition.string.end.json"
      ],
      "settings": {
        "foreground": "#F5C2E7"
      }
    }
  ],
  "semanticTokenColors": {
